<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/questionsFragment">

    <fragment
        android:id="@+id/questionsFragment"
        android:name="com.example.labactivity21.QuestionsFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_questions">
        <action
            android:id="@+id/action_questionsFragment_to_multipleChoiceFragment"
            app:destination="@id/multipleChoiceFragment" />
    </fragment>

    <fragment
        android:id="@+id/multipleChoiceFragment"
        android:name="com.example.labactivity21.MultipleChoiceFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_multiple_choice">
        <argument
            android:name="questionIndex"
            android:defaultValue="0"
            app:argType="integer" />
    </fragment>

</navigation>
